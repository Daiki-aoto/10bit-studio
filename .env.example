# Stripe 決済の設定例。これをコピーして .env.local を作り、値を入れる（.env.local は Git に入らない）
# テスト：STRIPE_MODE=test と rk_test_…/sk_test_… のキー ／ 本番：STRIPE_MODE=live と rk_live_…/sk_live_… のキー
NEXT_PUBLIC_PAYMENTS=stripe
STRIPE_MODE=test
STRIPE_SECRET_KEY=rk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3100
